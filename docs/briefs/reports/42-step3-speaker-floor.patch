diff --git a/src/pitch/math.ts b/src/pitch/math.ts
index 9f512cf..6b03d6c 100644
--- a/src/pitch/math.ts
+++ b/src/pitch/math.ts
@@ -1,5 +1,17 @@
 export const RANGE_SEMITONES = 5;
 
+/**
+ * Lowest pitch the listener searches for, from the speaker's own centre
+ * (brief 42): half the centre, kept between `lowHz` and `highHz`. A normal
+ * voice keeps 70 Hz (Jane: 181 → 70), a deep one goes down to 55 (centre
+ * 91 → 55). A fixed 55 Hz for everyone made the listener find fake low
+ * pitches at the quiet edges of a normal voice. No calibrated centre yet → `highHz`.
+ */
+export function speakerFloorHz(f0Center: number | null | undefined, lowHz = 55, highHz = 70): number {
+  if (f0Center == null || !(f0Center > 0)) return highHz;
+  return Math.min(highHz, Math.max(lowHz, f0Center / 2));
+}
+
 export function hzToSemitones(f0: number, f0Center: number): number {
   return 12 * Math.log2(f0 / f0Center);
 }
