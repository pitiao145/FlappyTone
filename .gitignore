# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.vercel

# Raw takes pulled from Blob by `npm run pull-recordings`. Not committed: the
# committed artefact is what `npm run make-clips` cuts out of them into
# public/ref/, and these stay re-pullable from storage. Deleting them locally
# costs a download, not a recording session.
fixtures/recordings/

# Play sessions pulled from Blob by `npm run pull-analytics`. Not committed for
# the same reason as the recordings, plus one of its own: these are other
# people's play data, and a public repo is not where it belongs. Blob is the
# system of record; these are a local working copy.
fixtures/analytics/
fixtures/captures/
fixtures/tonepairs/

docs/tonepairs/

docs/word_lists_local/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env*.local

.worktrees/
.claude/

# Wrangler's local dev/build state for the clips Worker.
workers/clips/.wrangler/
workers/clips/*.tsbuildinfo

# Cut clips written by `npm run process-clips` before they go to R2, plus the
# scratch downloads `npm run verify-clips` re-fetches to byte-compare against
# them. Neither is the artefact: the published clip lives in the
# flappytone-clips bucket and is named by the row's clip_key. These stay local
# so a clip that came out wrong can be listened to without another round trip.
fixtures/clips/

# Pre-migration reference recordings. Untracked as of Task 13 (audio now lives
# in the flappytone-clips R2 bucket, served through the Worker) but kept on
# disk locally as a safety net — not re-pullable from anywhere else, so don't
# delete your own copy.
public/ref/*.wav

# Dev-only tone-pair fixture audio, written by `npm run tonepairs:fixtures`.
# Regenerable from fixtures/tonepairs/wav/, and never part of a prod build.
public/dev-fixtures/
