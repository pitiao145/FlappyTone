{
  "name": "toneflap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "analyze": "node --experimental-strip-types src/dev/analyze.ts",
    "make-tones": "node --experimental-strip-types src/dev/make-tones.ts",
    "tune": "node --experimental-strip-types src/dev/tune.ts",
    "report": "node --experimental-strip-types src/dev/report.ts",
    "analyze-recording": "node --experimental-strip-types src/dev/analyze-recording.ts",
    "make-ref-clips": "node --experimental-strip-types src/dev/make-ref-clips.ts",
    "make-clips": "node --experimental-strip-types src/dev/make-clips.ts",
    "import-words": "node --experimental-strip-types src/dev/import-words.ts",
    "pull-recordings": "node --experimental-strip-types src/dev/pull-recordings.ts",
    "make-icons": "node --experimental-strip-types src/dev/make-icons.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "pitchy": "^4.1.0",
    "posthog-js": "^1.413.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
