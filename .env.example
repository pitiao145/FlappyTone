# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser
# bundle; everything else is server-side and is read by the functions in api/.

# --- Supabase (leaderboard + anonymous auth) -------------------------------
# The publishable key is meant to be public: it identifies the project and
# authorises nothing. Row-level security in Postgres is what guards the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server only — never prefix these with VITE_, never commit a real value.
# The service-role key bypasses row-level security entirely; api/score.ts is
# the only thing that holds it, because a leaderboard score is contestable.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Recording booth (/record) ---------------------------------------------
RECORD_PASSCODE=
BLOB_READ_WRITE_TOKEN=

# --- Newsletter signup (Kit / ConvertKit) ----------------------------------
KIT_API_KEY=
KIT_FORM_ID=
KIT_TAG_ID_COMING_SOON=
KIT_TAG_ID_MOBILE=
KIT_TAG_ID_EARLYBIRD=
SITE_URL=https://flappytone.com

# --- Lemon Squeezy (Pro entitlement) ----------------------------------------
# Server only. Verifies api/webhook-ls.ts's incoming signature — never expose
# this to the browser.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Server only. Not currently read by any function, but kept alongside the
# webhook secret for when the checkout link is built server-side.
LEMONSQUEEZY_STORE_ID=
# Reaches the browser bundle (VITE_ prefix) — this is fine, it's just a
# checkout link, nothing secret. The webhook secret above is what actually
# guards access; this URL grants nothing by itself.
VITE_LEMONSQUEEZY_CHECKOUT_URL=
